{
  "name": "simo-magnus-portfolio",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && node scripts/postbuild.mjs",
    "preview": "vite preview",
    "typecheck": "tsc -b",
